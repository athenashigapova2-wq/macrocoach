LLM_ROUTER_MODEL=
AGENT_BASELINE_VERSION=baseline-v1

GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2

# Idempotent LLM/read retries: 0.5s, 1s, ... plus up to 25% jitter.
SAFE_RETRY_MAX_ATTEMPTS=3
SAFE_RETRY_BASE_DELAY_SECONDS=0.5
SAFE_RETRY_MAX_DELAY_SECONDS=4.0
SAFE_RETRY_JITTER_RATIO=0.25

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only required for projects that still issue legacy HS256 access tokens.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

APP_ENV=dev
API_CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# Redis is the Celery broker and the short-lived job-status store.
REDIS_URL=redis://127.0.0.1:6379/0
AGENT_JOB_QUEUE=athena-agent
AGENT_JOB_TTL_SECONDS=3600

RAG_ENABLED=true
RAG_RETRIEVAL_LIMIT=6
RAG_MIN_SIMILARITY=0.55
RAG_CONTEXT_MAX_CHARS=12000
